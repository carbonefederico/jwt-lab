# Canonical public issuer. Keep this stable once consumers trust it.
JWT_ISSUER=https://jwt-lab.vercel.app

# Generate with: npm run generate:key
# Paste the single-line base64 PKCS#8 private key here.
JWT_PRIVATE_KEY_B64=

# Optional key id published in JWKS and placed in JWT headers.
JWT_KID=jwt-lab-rs256-1

# Optional. Defaults to 3600 seconds.
JWT_DEFAULT_TTL=3600
